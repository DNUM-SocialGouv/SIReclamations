      "details": {
        "type": "object",
        "title": "details",
        "description": "Modèle permettant de préciser et décrire la réclamation",
        "x-internal": false,
        "required": [
          "maltraitance",
          "typesDeFaits",
          "consequenceSurLaVictime",
