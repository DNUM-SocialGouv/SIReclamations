{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0",
    "title": "DeposerReclamation",
    "summary": "API destinée à la plateforme téléphonique d'écoute des situations de maltraitance pour déposer des réclamations ",
    "description": "Dans le cadre de l’application de la Loi « bien vieillir », promulguée le 8 avril 2024 et sur son volet permettant de « mieux signaler les maltraitances » et en vertu du 4 de l’article L1432-1 du code de la santé publique relatif aux cellules de recueil, cette API à vocation à couvrir le recueil pour l’affectation des demandes aux autorités compétentes.",
    "contact": {
      "name": "",
      "email": ""
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": ""
    }
  ],
  "paths": {
    "/api/v1/reclamation": {
      "post": {
        "summary": "Déposer une réclamation",
        "description": "Dans le cadre de l’application de la Loi « bien vieillir », promulguée le 8 avril 2024 et sur son volet permettant de « mieux signaler les maltraitances » et en vertu du 4 de l’article L1432-1 du code de la santé publique relatif aux cellules de recueil, cette API à vocation à couvir le recueil et l’affectation des demandes. ",
        "operationId": "post-api-v1-reclamation",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "description": "API key",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Soumission d'une réclamation",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reclamation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/reponseSuccesDepotReclamation"
                },
                "examples": {
                  "Example 1": {
                    "value": {
                      "status": 201,
                      "message": "Réclamation reçue et transférée à X et Y"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/reponseEchecDepotReclamation",
                  "x-examples": {
                    "Example 1": {
                      "status": 400,
                      "message": "Validation failed",
                      "errors": [
                        {
                          "field": "propertyName",
                          "errorCode": "ERROR_CODE",
                          "message": "Human-readable description of the error",
                          "rejectedValue": "valueProvided",
                          "additionalInfo": {
                            "hint": "Possible fix or additional context for debugging"
                          }
                        },
                        {
                          "field": "nestedObject.subProperty",
                          "errorCode": "ANOTHER_ERROR_CODE",
                          "message": "Another error description",
                          "rejectedValue": "anotherValue",
                          "additionalInfo": null
                        }
                      ]
                    }
                  }
                },
                "examples": {
                  "Example 1": {
                    "value": {
                      "status": 400,
                      "message": "La validation de la réclamation a échoué",
                      "errors": [
                        {
                          "field": "email",
                          "errorCode": "NON_VIDE",
                          "message": "L'adresse mail du déclarant est requise"
                        },
                        {
                          "field": "majeur",
                          "errorCode": "NON_MINEUR",
                          "message": "Le dépôt de réclamation concerne les personnes majeurs uniquement"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/reponseNonAuthorise",
                  "x-examples": {
                    "Example 1": {
                      "status": 401,
                      "message": "Authentication required",
                      "errorCode": "UNAUTHORIZED",
                      "details": "You must provide a valid access token to access this resource."
                    }
                  }
                },
                "examples": {
                  "Example 1": {
                    "value": {
                      "status": 401,
                      "message": "Authentication required",
                      "errorCode": "TOKEN_MISSING",
                      "details": "The access token is missing from the Authorization header."
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "servers": [
          {
            "url": "",
            "description": ""
          }
        ]
      }
    }
  },
