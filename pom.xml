            <plugin>
                <groupId>io.github.deweyjose</groupId>
                <artifactId>graphqlcodegen-maven-plugin</artifactId>
                <version>1.61.5</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <schemaPaths>
                        <param>src/main/resources/schema.graphql</param>
                    </schemaPaths>
                    <packageName>fr.gouv.social.sireclamations.generated</packageName>
                    <generateIsGetterForPrimitiveBooleanFields>true</generateIsGetterForPrimitiveBooleanFields>
                    <generateDocs>true</generateDocs>
                    <addGeneratedAnnotation>false</addGeneratedAnnotation>
                    <disableDatesInGeneratedAnnotation>true</disableDatesInGeneratedAnnotation>
                    <generateBoxedTypes>true</generateBoxedTypes>
                    <generateClientApiV2>false</generateClientApiV2>
                    <typeMapping>
                        <Date>java.time.LocalDateTime</Date>
                        <ISO8601DateTime>java.time.OffsetDateTime</ISO8601DateTime>
                        <ISO8601Date>java.time.LocalDate</ISO8601Date>
                        <URL>java.lang.String</URL>
                        <BigInt>java.lang.Long</BigInt>
                        <Coordinates>java.lang.String</Coordinates>
                    </typeMapping>
                    <outputDir>${project.build.directory}/generated-sources</outputDir>
                    <implementSerializable>true</implementSerializable>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

